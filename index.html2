  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              yellow: '#FFB800',
              orange: '#FF5722',
              pink: '#FF4081',
              dark: '#1E1E2F',
              line: '#06C755'
